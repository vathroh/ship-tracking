# Application Configuration
APP_PORT=8080
LOG_LEVEL=info

# PostgreSQL Configuration
# Format: host=... user=... password=... dbname=... port=... sslmode=...
POSTGRES_DSN=host=localhost user=root password=rootpassword dbname=cek_ongkir port=5432 sslmode=disable

# Redis Configuration
REDIS_ADDR=localhost:6379

# External API
BINDERBYTE_URL=https://api.binderbyte.com/v1
BINDERBYTE_API_KEY=your_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
